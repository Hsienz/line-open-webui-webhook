          "列出知識庫檔案"
        ],
        "enable": true
      },
      "add_file_to_knowledge": {
        "triggers": [
          "add_file_to_knowledge",
          "add-file-to-knowledge"
        ],
        "enable": true
      },
      "create_knowledge": {
        "triggers": [
          "create_knowledge",
          "create-knowledge",

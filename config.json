          "list-knowledges",
          "列出知識庫"
        ],
        "enable": true
      },
      "use_knowledge": {
        "triggers": [
          "use_knowledge",
          "use-knowledge",
          "使用知識庫"
        ],
        "params": [
          "number"
        ],
        "enable": true
      },
      "use_file": {
        "triggers": [
          "use_file",
          "use-file",
          "使用檔案"
        ],
        "params": [
          "number"
        ],
        "enable": true
      },
      "list_files": {
        "triggers": [
          "list_files",
          "list-files",
          "列出檔案"
        ],
        "enable": true
      },
      "list_knowledge_files": {
        "triggers": [
          "list_knowledge_files",
          "list-knowledge-files",
